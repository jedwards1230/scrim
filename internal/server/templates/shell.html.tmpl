<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}} &mdash; scrim</title>
<link rel="icon" href="{{.FaviconURL}}">
<style>
{{template "theme-css" .}}
  * { box-sizing: border-box; }
  html, body { height: 100%; }
  body {
    font-family: system-ui, sans-serif;
    margin: 0;
    display: flex;
    flex-direction: column;
    background: var(--bg);
    color: var(--fg);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.45rem 0.75rem;
    border-bottom: 1px solid var(--border);
    background: var(--card-bg);
    flex: 0 0 auto;
  }
  .bar-title { min-width: 0; }
  .bar-title h1 { margin: 0; font-size: 0.95rem; min-width: 0; }
  /* The title IS the canvas menu's trigger, so it has to read as a title
     first and a control second: no chrome at rest, a button's affordances on
     hover and focus. */
  .title-btn {
    display: flex; align-items: center; gap: 0.5rem; max-width: min(22rem, 45vw);
    border: 1px solid transparent; background: none; color: inherit;
    border-radius: 0.5rem; padding: 0.2rem 0.4rem;
    font: inherit; font-size: 0.95rem; font-weight: 600; cursor: pointer;
  }
  .title-btn:hover { border-color: var(--border); background: var(--bg); }
  .title-btn .name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .title-btn .caret { flex: 0 0 auto; font-size: 0.7rem; color: var(--muted); }
  .icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 1.75rem; height: 1.75rem; border-radius: 0.4rem;
    font-size: 1rem; flex: 0 0 auto;
  }
  .bar-actions { display: flex; align-items: center; gap: 0.4rem; flex: 0 0 auto; }
  .chip {
    display: inline-flex; align-items: center; gap: 0.3rem;
    border: 1px solid var(--border); background: var(--bg);
    border-radius: 999px; padding: 0.25rem 0.6rem; font-size: 0.8rem;
    max-width: 12rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .btn {
    border: 1px solid var(--border); background: var(--card-bg); color: var(--fg);
    border-radius: 0.5rem; padding: 0.3rem 0.6rem; cursor: pointer; font-size: 0.85rem;
    text-decoration: none; display: inline-block;
  }
  .btn:hover { border-color: var(--muted); }
  /* Share is the bar's one promoted action, so it carries a little more
     weight than the icon buttons beside it. */
  .btn-share { font-weight: 600; }
  .card-btn { /* revoke buttons inside the share dialog */
    border: 1px solid var(--border); background: var(--card-bg); color: var(--fg);
    border-radius: 0.5rem; padding: 0.3rem 0.6rem; cursor: pointer; font-size: 0.8rem;
  }
  :focus-visible { outline: 2px solid #3b82f6; outline-offset: 2px; }
  /* The popover chrome (.menu*, the account button) is shared with the gallery. */
{{template "menu-css" .}}  .versions { padding: 0.1rem 0.55rem 0.4rem; }
  .versions ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.2rem; }
  /* Version entries are text, not controls: no hover state and no pointer
     cursor, because nothing serves a snapshot's content yet. */
  .versions li { font-size: 0.78rem; color: var(--muted); display: flex; justify-content: space-between; gap: 0.5rem; cursor: default; }
  .versions li .name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .versions li .when { flex: 0 0 auto; }
  .menu-error { padding: 0.1rem 0.55rem 0.4rem; font-size: 0.78rem; color: #dc2626; }
  .menu-note { padding: 0.1rem 0.55rem 0.4rem; font-size: 0.78rem; color: var(--muted); }
  .menu-note a { color: inherit; }
  .frame { flex: 1 1 auto; width: 100%; border: 0; background: var(--card-bg); }
{{if .OIDC}}{{template "share-css" .}}{{end}}
  @media (prefers-reduced-motion: reduce) {
    * { animation: none !important; transition: none !important; }
  }
</style>
</head>
<body data-canvas-id="{{.ID}}">
<header class="bar">
  <!-- The bar is split on purpose. Sharing is the one action a viewer reaches
       for often enough to deserve its own control, so it sits at the right as
       a named button; everything else -- the canvas's own management verbs --
       hangs off the title at the left, where the thing being managed is
       named. Share therefore appears ONCE on this page: promoting it to the
       bar and also leaving it in the menu would be two triggers for one
       dialog. -->
  <div class="bar-title menu-wrap">
    <h1><button id="menu-btn" class="title-btn" type="button" data-menu aria-expanded="false" aria-controls="canvas-menu" title="{{.Title}}"><span class="icon" style="background:{{.Color}}22;">{{.Icon}}</span><span class="name">{{.Title}}</span><span class="caret" aria-hidden="true">&#9662;</span></button></h1>
    <div id="canvas-menu" class="menu menu-start" aria-labelledby="menu-btn" hidden>
      {{if .OIDC}}
      <div class="menu-head">
        <div class="who">{{if .Owned}}Artifact by you{{else}}Artifact by {{.OwnerLabel}}{{end}}</div>
        <div class="when">Updated {{.UpdatedAgo}}</div>
      </div>
      {{end}}
      <button class="menu-item" type="button" disabled aria-disabled="true" title="Not yet supported">Rename</button>
      {{if .CanDuplicate}}<button id="menu-duplicate" class="menu-item" type="button" data-duplicate="{{.ID}}">Duplicate</button>{{end}}
      <button id="menu-versions" class="menu-item" type="button" aria-expanded="false" aria-controls="version-list">Version history</button>
      <div id="version-list" class="versions" hidden></div>
      <button id="menu-refresh" class="menu-item" type="button">Refresh</button>
      <button class="menu-item" type="button" disabled aria-disabled="true" title="Not yet supported">Pin</button>
      <div class="menu-sep"></div>
      <a class="menu-item" href="/">All artifacts</a>
      {{if .CanDelete}}<div class="menu-sep"></div>
      <button id="menu-delete" class="menu-item menu-item-danger" type="button" data-delete="{{.ID}}" data-title="{{.Title}}">Delete&hellip;</button>{{end}}
      <div id="menu-note" class="menu-note" hidden></div>
      <div id="menu-error" class="menu-error" hidden></div>
    </div>
  </div>
  <div class="bar-actions">
    {{if .OIDC}}{{if .Account.Principal}}{{template "account-menu" .Account}}{{end}}{{end}}
    <button id="theme-toggle" class="btn" type="button" aria-label="Toggle light/dark theme">&#9788;/&#9790;</button>
    {{if .CanShare}}<button id="bar-share" class="btn btn-share" type="button" data-share="{{.ID}}" data-title="{{.Title}}">Share</button>{{end}}
  </div>
</header>
<iframe id="canvas-frame" class="frame" src="{{.RawURL}}" title="{{.Title}}"></iframe>
{{if .OIDC}}{{template "share-dialog" .}}{{end}}
<script>
{{template "theme-js" .}}
{{template "menu-js" .}}
(function () {
  // The canvas menu (#126). Its open/close/Escape/outside-click behavior is
  // the shared "menu-js" popover above, which the account menu uses too; this
  // block is only the menu's own items.
  //
  // NOTE: this page deliberately carries NO live-reload EventSource. The
  // canvas itself is served in the iframe below by the ordinary canvas path,
  // which injects the reload script there; a second EventSource here would
  // double every viewer's SSE connections (inflating the gallery's viewer
  // count and the hub's per-canvas caps) and would blow away open menu state
  // on every agent write.
  var menu = document.getElementById("canvas-menu");
  var frame = document.getElementById("canvas-frame");
  var errEl = document.getElementById("menu-error");
  var noteEl = document.getElementById("menu-note");

  function showError(msg) { errEl.textContent = msg; errEl.hidden = false; }
  function clearError() { errEl.textContent = ""; errEl.hidden = true; }
  function clearNote() { noteEl.replaceChildren(); noteEl.hidden = true; }
  function closeMenu() { if (menu.scrimClose) menu.scrimClose(); }

  // Refresh is purely client-side: re-load the iframe, no server round trip.
  document.getElementById("menu-refresh").addEventListener("click", function () {
    clearError();
    clearNote();
    try {
      frame.contentWindow.location.reload();
    } catch (err) {
      // Defensive: re-assigning src reloads it too.
      frame.setAttribute("src", frame.getAttribute("src"));
    }
    closeMenu();
  });

  // Version history: an ordinal ("Version 3"), the snapshot's label when it
  // has one, and a relative age with the absolute timestamp on the entry's
  // title (two snapshots taken the same afternoon both read "2h ago", so the
  // hover is what tells them apart). Entries are NOT clickable and carry no
  // hover/pointer affordance -- nothing serves a snapshot's content yet
  // (jedwards1230/scrim#127), so anything that looked like a control would be
  // a lie. The listing endpoint is hub-only, hence the explicit "unavailable"
  // branch for the local daemon.
  var versionsBtn = document.getElementById("menu-versions");
  var versionsBox = document.getElementById("version-list");
  var versionsLoaded = false;
  var CANVAS_ID = document.body.getAttribute("data-canvas-id") || "";

  function relative(iso) {
    var then = Date.parse(iso);
    if (isNaN(then)) return "";
    var secs = Math.max(0, Math.round((Date.now() - then) / 1000));
    if (secs < 60) return "just now";
    var mins = Math.round(secs / 60);
    if (mins < 60) return mins + "m ago";
    var hours = Math.round(mins / 60);
    if (hours < 24) return hours + "h ago";
    return Math.round(hours / 24) + "d ago";
  }

  function absolute(iso) {
    var then = new Date(iso);
    if (isNaN(then.getTime())) return "";
    // Locale-formatted, in the viewer's own timezone: the point is telling two
    // same-day versions apart, which needs a real date and clock time.
    return then.toLocaleString();
  }

  function renderVersions(entries) {
    versionsBox.replaceChildren();
    var list = document.createElement("ul");
    if (!entries || entries.length === 0) {
      var none = document.createElement("li");
      none.textContent = "No versions yet";
      list.appendChild(none);
    } else {
      entries.forEach(function (e, i) {
        // The API returns newest-first, so the newest gets the highest
        // ordinal: index 0 of N entries is "Version N".
        var ordinal = "Version " + (entries.length - i);
        var li = document.createElement("li");
        var name = document.createElement("span");
        name.className = "name";
        // textContent, never innerHTML: a snapshot label is agent-supplied.
        // The snapshot's on-disk directory name is deliberately never shown:
        // it is a timestamped internal identifier, not something for a human.
        name.textContent = e.label ? ordinal + " — " + e.label : ordinal;
        var age = relative(e.timestamp);
        var when = document.createElement("span");
        when.className = "when";
        when.textContent = age;
        // The whole entry is one accessible string, so a screen reader
        // announces the ordinal, the label and the age together rather than
        // two unrelated fragments -- the old markup announced an empty list
        // item.
        var exact = absolute(e.timestamp);
        li.setAttribute("aria-label", name.textContent + ", " + age + (exact ? " (" + exact + ")" : ""));
        if (exact) li.title = exact;
        li.appendChild(name);
        li.appendChild(when);
        list.appendChild(li);
      });
    }
    versionsBox.appendChild(list);
  }

  function loadVersions() {
    fetch("/api/canvases/" + encodeURIComponent(CANVAS_ID) + "/snapshots", { credentials: "same-origin" })
      .then(function (resp) {
        if (!resp.ok) return Promise.reject(new Error("HTTP " + resp.status));
        return resp.json();
      })
      .then(function (entries) {
        versionsLoaded = true;
        renderVersions(entries);
      })
      .catch(function () {
        versionsBox.replaceChildren();
        var p = document.createElement("p");
        p.textContent = "Version history isn't available on this server.";
        versionsBox.appendChild(p);
      });
  }

  versionsBtn.addEventListener("click", function () {
    var open = versionsBox.hidden;
    versionsBox.hidden = !open;
    versionsBtn.setAttribute("aria-expanded", open ? "true" : "false");
    if (open && !versionsLoaded) loadVersions();
  });

  // Duplicate: POST /api/canvases/{id}/copy, which a browser session may do
  // for a canvas it owns. "overwrite" is deliberately never sent -- a name
  // collision must come back as a 409 the viewer can react to, never a silent
  // clobber of somebody's canvas.
  //
  // On success the shell does NOT navigate: the viewer asked to copy this
  // canvas, not to leave it. It names the copy and offers a link, so the id
  // that was just created is visible either way.
  var dupBtn = document.getElementById("menu-duplicate");
  if (dupBtn) {
    dupBtn.addEventListener("click", function () {
      clearError();
      clearNote();
      var suggested = CANVAS_ID + "-copy";
      var target = window.prompt("Duplicate as:", suggested);
      if (target === null) return;
      target = target.trim();
      if (target === "") return;
      dupBtn.disabled = true;
      fetch("/api/canvases/" + encodeURIComponent(CANVAS_ID) + "/copy", {
        method: "POST",
        credentials: "same-origin",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ to: target })
      })
        .then(function (resp) {
          if (resp.ok) {
            dupBtn.disabled = false;
            showCopyMade(target);
            return;
          }
          if (resp.status === 409) throw new Error("A canvas named “" + target + "” already exists.");
          throw new Error("Couldn't duplicate this canvas (HTTP " + resp.status + ").");
        })
        .catch(function (e) {
          dupBtn.disabled = false;
          showError(e.message || "Couldn't duplicate this canvas.");
        });
    });
  }

  // The duplicate confirmation: the new canvas's id as text plus a real link
  // to it. Built with createElement/textContent -- the id is user-supplied, so
  // it is never spliced into markup.
  function showCopyMade(target) {
    noteEl.replaceChildren();
    noteEl.appendChild(document.createTextNode("Created "));
    var link = document.createElement("a");
    link.href = "/c/" + encodeURIComponent(target) + "/";
    link.textContent = target;
    noteEl.appendChild(link);
    noteEl.appendChild(document.createTextNode(". "));
    var open = document.createElement("a");
    open.href = link.href;
    open.textContent = "Open it";
    noteEl.appendChild(open);
    noteEl.appendChild(document.createTextNode("."));
    noteEl.hidden = false;
  }

  // Delete: the one destructive item in the menu. It is rendered only for a
  // viewer who may WRITE the canvas (the same gate as Duplicate -- see
  // shellData.CanDelete), and it always confirms first, naming the canvas, so
  // it can be hit neither by accident nor blind. On success there is nothing
  // left to show here, so the shell leaves for the gallery.
  var delBtn = document.getElementById("menu-delete");
  if (delBtn) {
    delBtn.addEventListener("click", function () {
      clearError();
      clearNote();
      var name = delBtn.getAttribute("data-title") || CANVAS_ID;
      if (!window.confirm("Delete “" + name + "”? This removes the canvas and its files for everyone. This can't be undone.")) return;
      delBtn.disabled = true;
      fetch("/api/canvases/" + encodeURIComponent(CANVAS_ID), {
        method: "DELETE",
        credentials: "same-origin"
      })
        .then(function (resp) {
          if (resp.ok) {
            window.location.assign("/");
            return;
          }
          if (resp.status === 403) throw new Error("You don't have permission to delete this canvas.");
          throw new Error("Couldn't delete this canvas (HTTP " + resp.status + ").");
        })
        .catch(function (e) {
          delBtn.disabled = false;
          showError(e.message || "Couldn't delete this canvas.");
        });
    });
  }
})();
{{if .OIDC}}
{{template "share-js" .}}
{{end}}
</script>
</body>
</html>
