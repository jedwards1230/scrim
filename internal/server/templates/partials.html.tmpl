{{- /*
Shared page partials for the server-rendered HTML pages (index, tokens,
canvas shell). Every define here is ACTION-FREE -- plain CSS, markup, or JS
with no {{...}} in it -- so html/template's contextual escaper splices the same
text into a <style>, a <script>, or the page body without anything to escape.
The ONE exception is "account-menu", which interpolates the viewer's identity.
It is invoked from page-body context only, on every page that uses it, and is
passed its own accountData sub-context rather than the page's data.

Wiring: each page template is parsed on top of a CLONE of this one (see
templates.go), so a page picks a partial up simply by invoking it, and the
escape analysis one page triggers never leaks into another. Anything that
needs per-page data stays in the page template.
*/ -}}

{{define "theme-css"}}  :root {
    color-scheme: light dark;
    --bg: #f7f7f8;
    --fg: #1a1a1a;
    --muted: #666;
    --card-bg: #ffffff;
    --border: #e2e2e2;
  }
  :root[data-theme="dark"] {
    --bg: #16171a;
    --fg: #e8e8e8;
    --muted: #9a9a9a;
    --card-bg: #212226;
    --border: #33343a;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #16171a;
      --fg: #e8e8e8;
      --muted: #9a9a9a;
      --card-bg: #212226;
      --border: #33343a;
    }
  }
{{end}}

{{define "theme-js"}}(function () {
  // Dashboard-chrome-only light/dark toggle: individual canvases are never
  // touched here -- they render exactly as their agent authored them. The
  // default follows prefers-color-scheme; the button flips an explicit
  // override that's remembered for next time.
  var toggle = document.getElementById("theme-toggle");
  if (!toggle) return;
  var root = document.documentElement;
  var stored = localStorage.getItem("scrim-theme");
  if (stored) root.setAttribute("data-theme", stored);
  toggle.addEventListener("click", function () {
    var current = root.getAttribute("data-theme");
    var prefersDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
    var next;
    if (current === "dark") next = "light";
    else if (current === "light") next = "dark";
    else next = prefersDark ? "light" : "dark";
    root.setAttribute("data-theme", next);
    localStorage.setItem("scrim-theme", next);
  });
})();
{{end}}

{{define "menu-css"}}  .menu-wrap { position: relative; }
  .menu {
    position: absolute; right: 0; top: calc(100% + 0.35rem); z-index: 10;
    min-width: 15rem; padding: 0.35rem;
    border: 1px solid var(--border); border-radius: 0.6rem;
    background: var(--card-bg);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
  }
  .menu[hidden] { display: none; }
  /* Menus hang from the right edge of their trigger by default, which is
     right for a trigger in the right-hand action group. A menu whose trigger
     sits at the LEFT edge of the bar (the canvas shell's title) must hang the
     other way, or it opens off the left of the viewport. */
  .menu-start { right: auto; left: 0; }
  .menu-head { padding: 0.4rem 0.55rem 0.5rem; border-bottom: 1px solid var(--border); margin-bottom: 0.3rem; }
  .menu-head .who { font-size: 0.85rem; overflow-wrap: anywhere; }
  .menu-head .when { font-size: 0.75rem; color: var(--muted); margin-top: 0.15rem; overflow-wrap: anywhere; }
  .menu-item {
    display: block; width: 100%; text-align: left;
    border: 0; background: none; color: var(--fg);
    border-radius: 0.4rem; padding: 0.4rem 0.55rem;
    font: inherit; font-size: 0.85rem; cursor: pointer; text-decoration: none;
  }
  .menu-item:hover:not([disabled]) { background: var(--bg); }
  .menu-item[disabled] { color: var(--muted); cursor: not-allowed; }
  .menu-item-danger { color: #dc2626; }
  .menu-sep { height: 1px; background: var(--border); margin: 0.3rem 0; }
  .menu-form { margin: 0; }
  /* The account menu's trigger is a real <button> wearing the chip's styling,
     so it inherits the page font instead of the UA's button font. */
  button.chip { font: inherit; font-size: 0.85rem; color: var(--fg); cursor: pointer; }
  button.chip:hover { border-color: var(--muted); }
{{end}}

{{define "account-menu"}}<div class="menu-wrap">
  <button id="account-btn" class="chip" type="button" data-menu aria-expanded="false" aria-controls="account-menu" title="{{.Principal}}">{{.Principal}}</button>
  <div id="account-menu" class="menu" aria-labelledby="account-btn" hidden>
    <div class="menu-head">
      {{if .Name}}<div class="who">{{.Name}}</div>{{end}}
      {{if .Email}}<div class="{{if .Name}}when{{else}}who{{end}}">{{.Email}}</div>{{end}}
    </div>
    <a class="menu-item" href="/tokens">Devices &amp; access</a>
    <form class="menu-form" method="POST" action="/auth/logout"><button class="menu-item" type="submit">Log out</button></form>
  </div>
</div>
{{end}}

{{define "menu-js"}}(function () {
  // Shared popover behavior for the header menus: the canvas shell's canvas
  // menu and the account menu on every page. One implementation, so the two
  // behave identically -- click toggles, an outside click closes, Escape
  // closes and returns focus to the trigger.
  //
  // Deliberately NOT an ARIA menu: there is no role="menu"/"menuitem" here.
  // That pattern promises Up/Down/Home/End roving-tabindex navigation, and
  // announcing it without implementing it tells assistive tech one thing while
  // behaving as another. These are plain popovers of buttons and links, which
  // Tab already traverses correctly, so the markup says exactly that: a button
  // with aria-expanded/aria-controls over ordinary controls.
  var wired = [];

  function closeAll() {
    wired.forEach(function (m) { m.close(); });
  }

  document.querySelectorAll("[data-menu]").forEach(function (btn) {
    var menu = document.getElementById(btn.getAttribute("aria-controls"));
    if (!menu) return;
    function setOpen(open) {
      menu.hidden = !open;
      btn.setAttribute("aria-expanded", open ? "true" : "false");
    }
    var entry = { btn: btn, menu: menu, close: function () { setOpen(false); } };
    setOpen(false);
    btn.addEventListener("click", function (e) {
      e.stopPropagation();
      var opening = menu.hidden;
      closeAll();
      setOpen(opening);
    });
    menu.addEventListener("click", function (e) { e.stopPropagation(); });
    // Let a page close its own menu after acting on an item without
    // re-deriving any of this.
    menu.scrimClose = entry.close;
    wired.push(entry);
  });

  document.addEventListener("click", closeAll);
  document.addEventListener("keydown", function (e) {
    if (e.key !== "Escape") return;
    wired.forEach(function (m) {
      if (m.menu.hidden) return;
      m.close();
      m.btn.focus();
    });
  });
})();
{{end}}

{{define "timefmt-js"}}  // Shared relative/absolute timestamp formatting for the dashboard pages:
  // the canvas shell's version history and the access page's "last used" line.
  // Both put a relative age in the text (which is what a human actually reads)
  // and hang the exact locale timestamp off a title attribute, because two
  // events on the same afternoon both read "2h ago" and the hover is what
  // tells them apart. One implementation, so the two pages can't drift.
  //
  // Declared inside the caller's IIFE, so these stay function-scoped instead
  // of becoming page globals.
  function relative(iso) {
    var then = Date.parse(iso);
    if (isNaN(then)) return "";
    var secs = Math.max(0, Math.round((Date.now() - then) / 1000));
    if (secs < 60) return "just now";
    var mins = Math.round(secs / 60);
    if (mins < 60) return mins + "m ago";
    var hours = Math.round(mins / 60);
    if (hours < 24) return hours + "h ago";
    return Math.round(hours / 24) + "d ago";
  }

  function absolute(iso) {
    var then = new Date(iso);
    if (isNaN(then.getTime())) return "";
    // Locale-formatted, in the viewer's own timezone: the point is telling two
    // same-day entries apart, which needs a real date and clock time.
    return then.toLocaleString();
  }
{{end}}

{{define "share-css"}}  dialog {
    border: 1px solid var(--border); border-radius: 0.75rem;
    background: var(--card-bg); color: var(--fg);
    padding: 1.25rem; max-width: 32rem; width: 90%;
  }
  dialog::backdrop { background: rgba(0, 0, 0, 0.4); }
  .dialog-head { display: flex; align-items: center; justify-content: space-between; margin: 0 0 0.5rem; }
  .dialog-head h2 { font-size: 1.1rem; margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  dialog section { margin-top: 1rem; }
  dialog h3 { font-size: 0.85rem; margin: 0 0 0.5rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; }
  #grant-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.4rem; }
  #grant-list li { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; font-size: 0.85rem; }
  .add-row { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; }
  .add-row select, .add-row input { font-size: 0.85rem; padding: 0.35rem 0.5rem; border-radius: 0.5rem; border: 1px solid var(--border); background: var(--bg); color: var(--fg); }
  .add-row input { flex: 1; min-width: 8rem; }
  .link-output { margin-top: 0.6rem; }
  .link-output input { width: 100%; font-size: 0.8rem; padding: 0.4rem 0.5rem; border-radius: 0.5rem; border: 1px solid var(--border); background: var(--bg); color: var(--fg); margin-bottom: 0.4rem; }
  .muted { color: var(--muted); font-size: 0.82rem; }
  .share-error { color: #dc2626; font-size: 0.82rem; margin-top: 0.5rem; }
{{end}}

{{define "share-dialog"}}<dialog id="share-dialog">
  <form class="dialog-head" method="dialog">
    <h2 id="share-title">Share</h2>
    <button class="btn" value="close">Close</button>
  </form>
  <div id="share-error" class="share-error" hidden></div>
  <section>
    <h3>Current sharing</h3>
    <ul id="grant-list"><li class="muted">Loading&hellip;</li></ul>
  </section>
  <section>
    <h3>Add access</h3>
    <div class="add-row">
      <select id="grant-kind">
        <option value="user">User (email)</option>
        <option value="group">Group</option>
        <option value="everyone">Everyone (logged-in)</option>
        <option value="link">Share link</option>
      </select>
      <input id="grant-target" list="principal-list" placeholder="email or group" autocomplete="off">
      <datalist id="principal-list"></datalist>
      <button id="grant-add" class="btn" type="button">Add</button>
    </div>
    <div id="link-output" class="link-output" hidden>
      <p class="muted">Copy this link now &mdash; the secret is shown only once:</p>
      <input id="link-url" readonly>
      <button id="link-copy" class="btn" type="button">Copy link</button>
    </div>
  </section>
</dialog>
{{end}}

{{define "share-js"}}(function () {
  // Share dialog (#53). Plain <dialog> + vanilla fetch, no framework, matching
  // the rest of these pages. Every principal-supplied string (grant target,
  // owner email, autocomplete suggestion) is written via textContent / .value,
  // never innerHTML, so nothing user-influenced is ever parsed as markup.
  //
  // Shared by the gallery (a Share button per card) and the canvas shell (one
  // Share menu item): both render the same #share-dialog markup and tag their
  // trigger with data-share/data-title, so this needs no per-page variant.
  var dialog = document.getElementById("share-dialog");
  if (!dialog || typeof dialog.showModal !== "function") return;
  var titleEl = document.getElementById("share-title");
  var errEl = document.getElementById("share-error");
  var listEl = document.getElementById("grant-list");
  var kindEl = document.getElementById("grant-kind");
  var targetEl = document.getElementById("grant-target");
  var datalistEl = document.getElementById("principal-list");
  var addBtn = document.getElementById("grant-add");
  var linkBox = document.getElementById("link-output");
  var linkUrl = document.getElementById("link-url");
  var linkCopy = document.getElementById("link-copy");
  var currentId = null;

  function showError(msg) { errEl.textContent = msg; errEl.hidden = false; }
  function clearError() { errEl.textContent = ""; errEl.hidden = true; }

  function canvasBase(id) {
    return window.location.origin + "/c/" + encodeURIComponent(id) + "/";
  }

  function grantRef(g) {
    if (g.kind === "link") return g.link_id;
    if (g.kind === "everyone") return "everyone";
    return g.target;
  }

  function grantLabel(g) {
    if (g.kind === "everyone") return "Everyone (logged-in)";
    if (g.kind === "link") return "Share link";
    return g.kind + ": " + g.target;
  }

  function renderGrants(grants) {
    listEl.replaceChildren();
    if (!grants || grants.length === 0) {
      var li = document.createElement("li");
      li.className = "muted";
      li.textContent = "Not shared with anyone yet.";
      listEl.appendChild(li);
      return;
    }
    grants.forEach(function (g) {
      var li = document.createElement("li");
      var label = document.createElement("span");
      label.textContent = grantLabel(g); // textContent: never parses target as markup
      var revoke = document.createElement("button");
      revoke.className = "card-btn";
      revoke.type = "button";
      revoke.textContent = "Revoke";
      revoke.addEventListener("click", function () { revokeGrant(grantRef(g)); });
      li.appendChild(label);
      li.appendChild(revoke);
      listEl.appendChild(li);
    });
  }

  function loadGrants(id) {
    fetch("/api/canvases/" + encodeURIComponent(id) + "/grants", { credentials: "same-origin" })
      .then(function (resp) {
        if (resp.status === 403) {
          listEl.replaceChildren();
          var li = document.createElement("li");
          li.className = "muted";
          li.textContent = "You can't view this canvas's sharing list.";
          listEl.appendChild(li);
          return null;
        }
        return resp.ok ? resp.json() : Promise.reject(new Error("HTTP " + resp.status));
      })
      .then(function (data) { if (data) renderGrants(data.grants); })
      .catch(function () { showError("Couldn't load the current sharing list."); });
  }

  function addGrant() {
    clearError();
    var kind = kindEl.value;
    var target = targetEl.value.trim();
    if ((kind === "user" || kind === "group") && target === "") {
      showError("A " + kind + " grant needs a target.");
      return;
    }
    var body = { kind: kind };
    if (kind === "user" || kind === "group") body.target = target;
    fetch("/api/canvases/" + encodeURIComponent(currentId) + "/grants", {
      method: "POST",
      credentials: "same-origin",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body)
    })
      .then(function (resp) {
        if (!resp.ok) return resp.json().then(function (e) { throw new Error(e.error || ("HTTP " + resp.status)); });
        return resp.json();
      })
      .then(function (g) {
        targetEl.value = "";
        if (g.kind === "link" && g.link_secret) {
          linkUrl.value = canvasBase(currentId) + "?k=" + encodeURIComponent(g.link_secret);
          linkBox.hidden = false;
        }
        loadGrants(currentId);
      })
      .catch(function (e) { showError(e.message || "Couldn't add that grant."); });
  }

  function revokeGrant(ref) {
    clearError();
    if (!ref) return;
    fetch("/api/canvases/" + encodeURIComponent(currentId) + "/grants/" + encodeURIComponent(ref), {
      method: "DELETE",
      credentials: "same-origin"
    })
      .then(function (resp) {
        if (!resp.ok && resp.status !== 404) throw new Error("HTTP " + resp.status);
        loadGrants(currentId);
      })
      .catch(function () { showError("Couldn't revoke that grant."); });
  }

  // Debounced principal autocomplete: fill the datalist from GET /api/principals.
  var acTimer = null;
  function autocomplete() {
    if (acTimer) clearTimeout(acTimer);
    acTimer = setTimeout(function () {
      var q = targetEl.value.trim();
      fetch("/api/principals?q=" + encodeURIComponent(q), { credentials: "same-origin" })
        .then(function (resp) { return resp.ok ? resp.json() : []; })
        .then(function (people) {
          datalistEl.replaceChildren();
          (people || []).forEach(function (p) {
            var opt = document.createElement("option");
            opt.value = p.email; // .value assignment: never parsed as markup
            if (p.display_name) opt.label = p.display_name;
            datalistEl.appendChild(opt);
          });
        })
        .catch(function () { /* autocomplete is best-effort; ignore */ });
    }, 150);
  }

  function openShare(id, title) {
    currentId = id;
    clearError();
    linkBox.hidden = true;
    linkUrl.value = "";
    targetEl.value = "";
    datalistEl.replaceChildren();
    titleEl.textContent = "Share “" + title + "”";
    listEl.replaceChildren();
    var li = document.createElement("li");
    li.className = "muted";
    li.textContent = "Loading…";
    listEl.appendChild(li);
    dialog.showModal();
    loadGrants(id);
  }

  addBtn.addEventListener("click", addGrant);
  targetEl.addEventListener("input", autocomplete);
  linkCopy.addEventListener("click", function () {
    linkUrl.select();
    if (navigator.clipboard) navigator.clipboard.writeText(linkUrl.value).catch(function () {});
    else document.execCommand("copy");
  });

  document.querySelectorAll("[data-share]").forEach(function (btn) {
    btn.addEventListener("click", function () {
      openShare(btn.getAttribute("data-share"), btn.getAttribute("data-title") || "");
    });
  });
})();
{{end}}
