<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>scrim &mdash; devices &amp; access</title>
<style>
{{template "theme-css" .}}
  * { box-sizing: border-box; }
  body {
    font-family: system-ui, sans-serif;
    margin: 0;
    padding: 2rem;
    background: var(--bg);
    color: var(--fg);
  }
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 48rem;
    margin: 0 auto 1.5rem;
  }
  h1 { font-size: 1.25rem; margin: 0; }
  main { max-width: 48rem; margin: 0 auto; }
  .header-actions { display: flex; align-items: center; gap: 0.5rem; }
  .chip {
    display: inline-flex; align-items: center; gap: 0.3rem;
    border: 1px solid var(--border); background: var(--card-bg);
    border-radius: 999px; padding: 0.3rem 0.7rem; font-size: 0.85rem;
    max-width: 14rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .btn {
    border: 1px solid var(--border); background: var(--card-bg); color: var(--fg);
    border-radius: 0.5rem; padding: 0.35rem 0.7rem; cursor: pointer; font-size: 0.85rem;
    text-decoration: none; display: inline-block;
  }
  .btn:hover { border-color: var(--muted); }
{{template "menu-css" .}}  section { margin-bottom: 2rem; }
  h2 { font-size: 0.95rem; margin: 0 0 0.6rem; }
  .card {
    border: 1px solid var(--border); border-radius: 0.75rem;
    padding: 1rem; background: var(--card-bg); margin-bottom: 0.75rem;
  }
  .mint-row { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }
  input[type="text"], input[type="email"] {
    font-size: 0.85rem; padding: 0.4rem 0.55rem; border-radius: 0.5rem;
    border: 1px solid var(--border); background: var(--bg); color: var(--fg);
  }
  .mint-row input { flex: 1; min-width: 10rem; }
  .options { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 0.6rem; font-size: 0.82rem; color: var(--muted); }
  .options label { display: inline-flex; align-items: center; gap: 0.3rem; }
  .options input[type="text"] { flex: none; width: 12rem; }
  .token { display: flex; align-items: flex-start; justify-content: space-between; gap: 0.75rem; }
  .token .name { font-weight: 600; }
  /* Recency leads: it's the one fact this page exists to surface, so it sits
     directly under the name in body-text weight, above the smaller detail. */
  .token .lead { font-size: 0.88rem; margin-top: 0.2rem; }
  .token .lead.never { color: var(--muted); }
  .token .detail { font-size: 0.8rem; color: var(--muted); margin-top: 0.25rem; }
  .token.revoked { opacity: 0.55; }
  .pill { font-size: 0.7rem; border-radius: 999px; padding: 0.1rem 0.5rem; border: 1px solid var(--border); color: var(--muted); }
  .badge {
    font-size: 0.7rem; border-radius: 999px; padding: 0.1rem 0.5rem;
    border: 1px solid var(--border); color: var(--muted);
    margin-left: 0.4rem; white-space: nowrap;
  }
  .secret-box { margin-top: 0.6rem; }
  .secret-box input { width: 100%; font-size: 0.8rem; padding: 0.4rem 0.5rem; border-radius: 0.5rem; border: 1px solid var(--border); background: var(--bg); color: var(--fg); margin-bottom: 0.4rem; }
  .muted { color: var(--muted); font-size: 0.82rem; }
  .note { max-width: 42rem; line-height: 1.45; margin: 0 0 0.9rem; }
  .disclosure { margin-top: 0.5rem; }
  .error { color: #dc2626; font-size: 0.82rem; margin-top: 0.5rem; }
  footer { margin-top: 2rem; color: var(--muted); font-size: 0.85rem; max-width: 48rem; margin-left: auto; margin-right: auto; }
</style>
</head>
<body>
<header>
  <h1>Devices &amp; access</h1>
  <div class="header-actions">
    {{if .Account.Principal}}{{template "account-menu" .Account}}{{end}}
    <a class="btn" href="/">&larr; Gallery</a>
    <button id="theme-toggle" class="btn" type="button" aria-label="Toggle light/dark theme">&#9788;/&#9790;</button>
  </div>
</header>
<main>
  <section id="sessions">
    <h2>Browsers you're signed in from</h2>
    <p class="muted note" id="session-note">
      Every browser signed in to this hub with your account. Signing one out takes effect on its
      next request &mdash; it doesn't wait for the session to expire on its own. A device is
      identified only by the browser it reports; scrim records no IP addresses and no location.
      Sessions that have already expired drop off this list by themselves.
    </p>
    <div id="session-list"><p class="muted">Loading&hellip;</p></div>
    <div id="session-error" class="error" hidden></div>
  </section>
  <section id="access">
    <h2>What has access to your canvases</h2>
    <p class="muted note">
      Tokens are the credentials you hand to a CLI, an agent, or an MCP client &mdash; separate
      from the browser sign-ins above, and unaffected by signing a browser out.
    </p>
    <div id="token-list"><p class="muted">Loading&hellip;</p></div>
    <div class="disclosure" id="revoked-wrap" hidden>
      <button id="revoked-toggle" class="btn" type="button" aria-expanded="false" aria-controls="revoked-list">Show revoked</button>
      <div id="revoked-list" hidden></div>
    </div>
  </section>
  <section id="mint">
    <h2>Create a new token</h2>
    <div class="card">
      <div class="mint-row">
        <input id="mint-name" type="text" placeholder="Token name (e.g. laptop CLI)">
        <button id="mint-btn" class="btn" type="button">Mint</button>
      </div>
      <div class="options">
        <label><input id="allow-everyone" type="checkbox"> allow sharing to everyone</label>
        <label><input id="allow-links" type="checkbox"> allow minting share links</label>
        <label>allow user emails: <input id="allow-emails" type="text" placeholder="comma-separated"></label>
        <label>allow groups: <input id="allow-groups" type="text" placeholder="comma-separated"></label>
        <label><input id="autoshare-everyone" type="checkbox"> auto-share new canvases to everyone</label>
      </div>
      <div id="secret-box" class="secret-box" hidden>
        <p class="muted">Copy this token now &mdash; it is shown only once:</p>
        <input id="secret-value" readonly>
        <button id="secret-copy" class="btn" type="button">Copy token</button>
      </div>
      <div id="mint-error" class="error" hidden></div>
    </div>
  </section>
</main>
<footer>scrim {{.Version}}</footer>
<script>
{{template "theme-js" .}}
{{template "menu-js" .}}
(function () {
  // Devices & access (#53). This page reads as an account's "devices / active
  // sessions" view: it LEADS with what currently has access, ordered by
  // recency, and keeps minting below that. Everything is driven by the
  // /api/tokens JSON endpoints (list/mint/revoke) -- no new auth surface, no
  // new routes.
  //
  // Every principal-supplied value (name, owner email, allowance targets) is
  // written via textContent / .value, never innerHTML.
  var sessionListEl = document.getElementById("session-list");
  var sessionErrEl = document.getElementById("session-error");
  var listEl = document.getElementById("token-list");
  var revokedWrap = document.getElementById("revoked-wrap");
  var revokedToggle = document.getElementById("revoked-toggle");
  var revokedList = document.getElementById("revoked-list");
  var nameEl = document.getElementById("mint-name");
  var mintBtn = document.getElementById("mint-btn");
  var errEl = document.getElementById("mint-error");
  var secretBox = document.getElementById("secret-box");
  var secretVal = document.getElementById("secret-value");
  var secretCopy = document.getElementById("secret-copy");
  var allowEveryone = document.getElementById("allow-everyone");
  var allowLinks = document.getElementById("allow-links");
  var allowEmails = document.getElementById("allow-emails");
  var allowGroups = document.getElementById("allow-groups");
  var autoshareEveryone = document.getElementById("autoshare-everyone");

  // A token untouched for this long, or one never used at all since it was
  // minted this long ago, gets a neutral "worth a look" badge. Stated as
  // information, not alarm: an unused token is not evidence of anything wrong.
  var STALE_USED_DAYS = 90;
  var STALE_UNUSED_DAYS = 30;

{{template "timefmt-js" .}}
  function daysSince(iso) {
    var then = Date.parse(iso);
    if (isNaN(then)) return 0;
    return (Date.now() - then) / 86400000;
  }

  function showError(msg) { errEl.textContent = msg; errEl.hidden = false; }
  function clearError() { errEl.textContent = ""; errEl.hidden = true; }

  function csv(s) {
    return s.split(",").map(function (x) { return x.trim(); }).filter(function (x) { return x !== ""; });
  }

  function allowanceSummary(a) {
    if (!a) return "no sharing allowance";
    var parts = [];
    if (a.everyone) parts.push("everyone");
    if (a.links) parts.push("links");
    if (a.emails && a.emails.length) parts.push("users: " + a.emails.join(", "));
    if (a.groups && a.groups.length) parts.push("groups: " + a.groups.join(", "));
    return parts.length ? "may share to " + parts.join("; ") : "no sharing allowance";
  }

  function autoShareSummary(grants) {
    if (!grants || !grants.length) return "";
    var kinds = grants.map(function (g) { return g.kind === "user" || g.kind === "group" ? g.kind + ":" + g.target : g.kind; });
    return "auto-shares: " + kinds.join(", ");
  }

  // Most recently active first, then the never-used, then newest-minted within
  // each group. The API sorts by creation date, which answers a different
  // question -- this ordering is entirely client-side and leaves the API's
  // contract alone.
  function byRecency(a, b) {
    var au = a.last_used ? Date.parse(a.last_used) : NaN;
    var bu = b.last_used ? Date.parse(b.last_used) : NaN;
    var aUsed = !isNaN(au), bUsed = !isNaN(bu);
    if (aUsed && bUsed) return bu - au;
    if (aUsed !== bUsed) return aUsed ? -1 : 1;
    return (Date.parse(b.created_at) || 0) - (Date.parse(a.created_at) || 0);
  }

  function staleLabel(t) {
    if (t.last_used) {
      return daysSince(t.last_used) >= STALE_USED_DAYS ? "not used in " + STALE_USED_DAYS + "+ days" : "";
    }
    return daysSince(t.created_at) >= STALE_UNUSED_DAYS ? "never used since it was created" : "";
  }

  function tokenCard(t) {
    var card = document.createElement("div");
    card.className = "card token" + (t.revoked ? " revoked" : "");

    var left = document.createElement("div");
    var name = document.createElement("div");
    name.className = "name";
    name.textContent = t.name || "(unnamed)"; // textContent: a token name is principal-supplied

    var stale = staleLabel(t);
    if (stale && !t.revoked) {
      var badge = document.createElement("span");
      badge.className = "badge";
      badge.textContent = stale;
      name.appendChild(badge);
    }
    left.appendChild(name);

    // The lead line is recency, phrased relatively, with the exact timestamp on
    // the title -- the same treatment the canvas shell gives version history.
    // A token that has NEVER been used says so outright: the old page simply
    // omitted the bit, which made "never" and "long ago" look identical.
    var lead = document.createElement("div");
    lead.className = "lead";
    if (t.last_used) {
      lead.textContent = "Last used " + relative(t.last_used);
      var exact = absolute(t.last_used);
      if (exact) lead.title = exact;
    } else {
      lead.className = "lead never";
      lead.textContent = "Never used";
    }
    left.appendChild(lead);

    var detail = document.createElement("div");
    detail.className = "detail";
    var bits = ["created " + relative(t.created_at)];
    bits.push(allowanceSummary(t.allowed_grant_targets));
    var as = autoShareSummary(t.auto_share);
    if (as) bits.push(as);
    detail.textContent = bits.join(" · ");
    var created = absolute(t.created_at);
    if (created) detail.title = "Created " + created;
    left.appendChild(detail);
    card.appendChild(left);

    if (t.revoked) {
      var pill = document.createElement("span");
      pill.className = "pill";
      pill.textContent = "revoked";
      card.appendChild(pill);
    } else {
      var btn = document.createElement("button");
      btn.className = "btn";
      btn.type = "button";
      btn.textContent = "Revoke";
      btn.addEventListener("click", function () { revoke(t.id); });
      card.appendChild(btn);
    }
    return card;
  }

  // Frames the absence for what it is -- nothing else can reach these canvases
  // -- rather than as a missing thing to go create. The second sentence has to
  // stay true when revoked tokens exist, so it differs in that case.
  function emptyState(hasRevoked) {
    var p = document.createElement("p");
    p.className = "muted";
    p.textContent = hasRevoked
      ? "Nothing else has access to your canvases. Every token you've created has been revoked, so only your own browser sign-in can reach them."
      : "Nothing else has access to your canvases. You haven't created any tokens, so only your own browser sign-in can reach them.";
    return p;
  }

  function setRevokedOpen(open) {
    revokedList.hidden = !open;
    revokedToggle.setAttribute("aria-expanded", open ? "true" : "false");
    revokedToggle.textContent = (open ? "Hide revoked (" : "Show revoked (") + revokedList.childElementCount + ")";
  }

  function renderTokens(tokens) {
    listEl.replaceChildren();
    revokedList.replaceChildren();
    // Re-rendering after a revoke must not slam the disclosure shut on someone
    // who had it open.
    var wasOpen = revokedToggle.getAttribute("aria-expanded") === "true";
    var all = (tokens || []).slice();
    var live = all.filter(function (t) { return !t.revoked; }).sort(byRecency);
    var dead = all.filter(function (t) { return t.revoked; }).sort(byRecency);

    if (live.length === 0) {
      listEl.appendChild(emptyState(dead.length > 0));
    } else {
      live.forEach(function (t) { listEl.appendChild(tokenCard(t)); });
    }

    // Revoked credentials are history, not access: they stay out of the live
    // list entirely and behind a disclosure that disappears when empty.
    if (dead.length === 0) {
      revokedWrap.hidden = true;
      return;
    }
    dead.forEach(function (t) { revokedList.appendChild(tokenCard(t)); });
    revokedWrap.hidden = false;
    setRevokedOpen(wasOpen);
  }

  function load() {
    fetch("/api/tokens", { credentials: "same-origin" })
      .then(function (resp) { return resp.ok ? resp.json() : []; })
      .then(renderTokens)
      .catch(function () {
        listEl.replaceChildren();
        revokedWrap.hidden = true;
        var p = document.createElement("p");
        p.className = "muted";
        p.textContent = "Couldn't load your tokens.";
        listEl.appendChild(p);
      });
  }

  function mint() {
    clearError();
    secretBox.hidden = true;
    var body = {
      name: nameEl.value.trim(),
      allowed_grant_targets: {
        everyone: allowEveryone.checked,
        links: allowLinks.checked,
        emails: csv(allowEmails.value),
        groups: csv(allowGroups.value)
      }
    };
    if (autoshareEveryone.checked) body.auto_share = [{ kind: "everyone" }];
    mintBtn.disabled = true;
    fetch("/api/tokens", {
      method: "POST",
      credentials: "same-origin",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body)
    })
      .then(function (resp) {
        if (!resp.ok) return resp.json().then(function (e) { throw new Error(e.error || ("HTTP " + resp.status)); });
        return resp.json();
      })
      .then(function (r) {
        secretVal.value = r.token;
        secretBox.hidden = false;
        nameEl.value = "";
        load();
      })
      .catch(function (e) { showError(e.message || "Couldn't mint a token."); })
      .finally(function () { mintBtn.disabled = false; });
  }

  function revoke(id) {
    clearError();
    fetch("/api/tokens/" + encodeURIComponent(id), { method: "DELETE", credentials: "same-origin" })
      .then(function (resp) {
        if (!resp.ok && resp.status !== 404) throw new Error("HTTP " + resp.status);
        load();
      })
      .catch(function () { showError("Couldn't revoke that token."); });
  }

  // ---- Browser sessions (#145) -------------------------------------------
  //
  // Sign-ins are server-side records now, so this section is a real device
  // list: each entry can be ended remotely and stops working on that browser's
  // very next request.

  // Deliberately CRUDE user-agent parsing. A UA string cannot be parsed
  // reliably -- every browser lies about being every other browser -- so this
  // recognises a handful of common tokens in a specific order and otherwise
  // shows the raw string. An honest "Mozilla/5.0 (…)" beats a confidently
  // wrong "Safari on Windows": the point is for a person to recognise their
  // own device, not for scrim to claim it identified one.
  function deviceLabel(ua) {
    if (!ua) return "Unknown device";
    var browser = "";
    // Order matters: Edge/Opera/Chrome all carry "Chrome", and Chrome carries
    // "Safari", so the most specific token has to win first.
    if (/\bEdg\//.test(ua)) browser = "Edge";
    else if (/\bOPR\/|\bOpera\b/.test(ua)) browser = "Opera";
    else if (/\bFirefox\//.test(ua)) browser = "Firefox";
    else if (/\bChrome\//.test(ua)) browser = "Chrome";
    else if (/\bSafari\//.test(ua)) browser = "Safari";

    var os = "";
    if (/\biPhone\b|\biPad\b|\biPod\b/.test(ua)) os = "iOS";
    else if (/\bAndroid\b/.test(ua)) os = "Android";
    else if (/\bWindows\b/.test(ua)) os = "Windows";
    else if (/\bMac OS X\b|\bMacintosh\b/.test(ua)) os = "macOS";
    else if (/\bCrOS\b/.test(ua)) os = "ChromeOS";
    else if (/\bLinux\b/.test(ua)) os = "Linux";

    if (browser && os) return browser + " on " + os;
    if (browser) return browser;
    if (os) return os;
    return ua; // no guess to make -- show what the browser actually sent
  }

  function showSessionError(msg) { sessionErrEl.textContent = msg; sessionErrEl.hidden = false; }
  function clearSessionError() { sessionErrEl.textContent = ""; sessionErrEl.hidden = true; }

  function sessionCard(s) {
    var card = document.createElement("div");
    card.className = "card token";

    var left = document.createElement("div");
    var name = document.createElement("div");
    name.className = "name";
    // textContent throughout: a user agent is client-supplied text.
    name.textContent = deviceLabel(s.user_agent);
    if (s.current) {
      var badge = document.createElement("span");
      badge.className = "badge";
      badge.textContent = "This browser";
      name.appendChild(badge);
    }
    left.appendChild(name);

    var lead = document.createElement("div");
    lead.className = "lead";
    lead.textContent = "Last seen " + relative(s.last_seen);
    var seen = absolute(s.last_seen);
    if (seen) lead.title = seen;
    left.appendChild(lead);

    var detail = document.createElement("div");
    detail.className = "detail";
    detail.textContent = "signed in " + relative(s.created_at) + " · expires " + until(s.expires_at);
    var created = absolute(s.created_at);
    if (created) detail.title = "Signed in " + created;
    left.appendChild(detail);

    // The raw string stays available on hover: the label above is a guess, this
    // is what the browser actually sent.
    if (s.user_agent) name.title = s.user_agent;
    card.appendChild(left);

    var btn = document.createElement("button");
    btn.className = "btn";
    btn.type = "button";
    btn.textContent = s.current ? "Sign out here" : "Sign out";
    btn.addEventListener("click", function () { revokeSession(s); });
    card.appendChild(btn);
    return card;
  }

  function renderSessions(sessions) {
    sessionListEl.replaceChildren();
    var all = sessions || [];
    if (all.length === 0) {
      var p = document.createElement("p");
      p.className = "muted";
      // Reachable when the hub runs without OIDC login, where there are no
      // browser sessions to record in the first place.
      p.textContent = "No browser sign-ins are recorded for your account.";
      sessionListEl.appendChild(p);
      return;
    }
    all.forEach(function (s) { sessionListEl.appendChild(sessionCard(s)); });
  }

  function loadSessions() {
    fetch("/api/sessions", { credentials: "same-origin" })
      .then(function (resp) {
        if (!resp.ok) throw new Error("HTTP " + resp.status);
        return resp.json();
      })
      .then(renderSessions)
      .catch(function () {
        sessionListEl.replaceChildren();
        var p = document.createElement("p");
        p.className = "muted";
        // Never say "no other sessions" when the truth is "couldn't ask" -- on
        // this page those two read identically and mean opposite things.
        p.textContent = "Couldn't load your browser sign-ins.";
        sessionListEl.appendChild(p);
      });
  }

  function revokeSession(s) {
    // Signing yourself out of the browser you're using is a legitimate action
    // (a shared machine), but it must never be a surprise.
    if (s.current && !window.confirm("Sign out of this browser? You'll be signed out here immediately and will need to log in again.")) return;
    clearSessionError();
    fetch("/api/sessions/" + encodeURIComponent(s.id), { method: "DELETE", credentials: "same-origin" })
      .then(function (resp) {
        if (!resp.ok && resp.status !== 404) throw new Error("HTTP " + resp.status);
        // Ending the current session invalidates this page's own cookie, so
        // reload into the login flow rather than leaving a dead page up.
        if (s.current) { window.location.reload(); return; }
        loadSessions();
      })
      .catch(function () { showSessionError("Couldn't sign that browser out."); });
  }

  revokedToggle.addEventListener("click", function () { setRevokedOpen(revokedList.hidden); });
  mintBtn.addEventListener("click", mint);
  secretCopy.addEventListener("click", function () {
    secretVal.select();
    if (navigator.clipboard) navigator.clipboard.writeText(secretVal.value).catch(function () {});
    else document.execCommand("copy");
  });
  loadSessions();
  load();
})();
</script>
</body>
</html>
